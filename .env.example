# Backend address. All /api/* requests are forwarded to it (runtime).
PUBLIC_API_URL=http://localhost:8080

# Browser log level for production builds: none, error, warn, info, debug (build time).
# In dev mode all logs are always enabled.
VITE_LOG_LEVEL=warn

# Only behind an HTTPS reverse proxy: the public https:// address of the app.
# Leave empty otherwise.
ORIGIN=
