# Logging
# Log level for production builds (none, error, warn, info, debug)
# In dev mode, all logs are always enabled regardless of this setting
VITE_LOG_LEVEL=warn

# Metabase Integration (runtime env vars - work in Docker containers)
# Base URL of the Metabase instance (e.g., http://localhost:3000 or https://metabase.example.com)
PUBLIC_METABASE_URL=http://localhost:3000

# UUID of the public dashboard to embed on the Statistics page
# Get this from Metabase: Share → Public link → copy the UUID from the URL
# Example: if public link is http://localhost:3000/public/dashboard/abc-123-def-456
# then use: PUBLIC_METABASE_DASHBOARD_ID=abc-123-def-456
PUBLIC_METABASE_DASHBOARD_ID=
