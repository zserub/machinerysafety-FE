# Machinery Safety - server configuration
# Copy to .env and fill in every value marked CHANGE ME.
# Generate secrets with:  openssl rand -base64 32

# --- Network -----------------------------------------------------------------
# Address users type in the browser (server IP or LAN hostname), no trailing slash
# CHANGE ME
APP_URL=http://192.168.1.10
# Address browsers use to reach Metabase (statistics page iframe)
# CHANGE ME
METABASE_PUBLIC_URL=http://192.168.1.10:3000

# Interface to listen on (0.0.0.0 = all, or a specific LAN IP)
BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=80
METABASE_PORT=3000

# --- Database ----------------------------------------------------------------
POSTGRES_DB=machinery_safety
POSTGRES_USER=postgres
# CHANGE ME
POSTGRES_PASSWORD=
DB_SCHEMA=eng
# Create/upgrade database tables on backend startup
RUN_MIGRATIONS=true

# --- First admin account -----------------------------------------------------
# Created on first start only (when the database has no users). Log in with it,
# then clear INITIAL_ADMIN_PASSWORD. Password: at least 8 characters.
INITIAL_ADMIN_USERNAME=admin
# CHANGE ME
INITIAL_ADMIN_PASSWORD=

# --- File storage (photos) ---------------------------------------------------
MINIO_ROOT_USER=minioadmin
# CHANGE ME (min. 8 chars)
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=photos

# --- Sessions ----------------------------------------------------------------
# 32-byte base64 key: openssl rand -base64 32
# CHANGE ME
SESSION_KEY=
# true only if users reach the app over HTTPS, otherwise login won't stick
SESSION_SECURE=false
# Only behind an HTTPS reverse proxy: the https:// address users open
# (same as APP_URL). Leave empty for plain HTTP, otherwise photo uploads fail.
ORIGIN=

# --- Metabase ----------------------------------------------------------------
METABASE_API_KEY=
RUN_METABASE_SETUP=false
METABASE_DATABASE_ID=3
METABASE_JAVA_OPTS=-Xmx1g

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
